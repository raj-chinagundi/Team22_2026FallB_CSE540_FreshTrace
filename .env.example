# Copy to .env and fill in. Don't commit .env.

AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Test MetaMask account used to deploy (becomes the admin). Get POL from the Amoy faucet.
DEPLOYER_PRIVATE_KEY=

# Wallet for the sensor script (needs the Sensor role)
SENSOR_PRIVATE_KEY=

# Pinata JWT for uploading certificates to IPFS
PINATA_JWT=
